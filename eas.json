{
  "cli": {
    "version": ">= 5.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "RCT_NEW_ARCH_ENABLED": "1",
        "APP_VARIANT": "dev"
      },
      "ios": {
        "simulator": false
      }
    },

    "preview": {
      "distribution": "internal",
      "env": {
        "RCT_NEW_ARCH_ENABLED": "1",
        "APP_VARIANT": "dev"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },

    "production": {
      "distribution": "store",
      "env": {
        "RCT_NEW_ARCH_ENABLED": "1",
        "APP_VARIANT": "prod"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      }
    }
  }
}